NODE_ENV=development
GATEWAY_PORT=4000
GRAPHQL_PORT=4200
INVENTORY_PORT=4101
ORDERS_PORT=4102
CLIENTS_PORT=4103
PAYMENTS_PORT=4104
# Generate a different random value for every service credential below.
GATEWAY_INVENTORY_READ_TOKEN=replace-with-unique-inventory-read-value
GATEWAY_INVENTORY_WRITE_TOKEN=replace-with-unique-inventory-write-value
ORDERS_INVENTORY_READ_TOKEN=replace-with-unique-orders-inventory-read-value
ORDERS_INVENTORY_TOKEN=replace-with-unique-orders-to-inventory-value
GATEWAY_GRAPHQL_TOKEN=replace-with-unique-gateway-to-graphql-value
GRAPHQL_ORDERS_READ_TOKEN=replace-with-unique-graphql-to-orders-value
GRAPHQL_INVENTORY_READ_TOKEN=replace-with-unique-graphql-to-inventory-value
GATEWAY_CLIENTS_TOKEN=replace-with-unique-gateway-to-clients-value
GATEWAY_ORDERS_CREATE_TOKEN=replace-with-unique-orders-create-value
GATEWAY_ORDERS_READ_TOKEN=replace-with-unique-orders-read-value
GATEWAY_ORDERS_OPERATIONS_TOKEN=replace-with-unique-orders-operations-value
PAYMENTS_ORDERS_TOKEN=replace-with-unique-payments-to-orders-value
GATEWAY_PAYMENTS_API_TOKEN=replace-with-unique-payments-api-value
GATEWAY_PAYMENTS_EVENT_TOKEN=replace-with-unique-payments-event-value
SESSION_SECRET=replace-with-a-different-long-random-local-value
PAYMENT_WEBHOOK_SECRET=replace-with-a-third-long-random-local-value
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
DEMO_CLIENT_EMAIL=cliente@tokyonoodles.test
DEMO_CLIENT_PASSWORD=change-this-local-demo-password
DEMO_INVENTORY_EMAIL=inventario@tokyonoodles.test
DEMO_INVENTORY_PASSWORD=change-this-local-inventory-password
DEMO_OPERATIONS_EMAIL=operaciones@tokyonoodles.test
DEMO_OPERATIONS_PASSWORD=change-this-local-operations-password
